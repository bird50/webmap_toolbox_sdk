{
  "name": "@thaiwater/toolbox-sdk",
  "version": "1.11.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "private": true,
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./react/core": {
      "types": "./dist/ui/core.d.ts",
      "import": "./dist/ui/core.js",
      "default": "./dist/ui/core.js"
    },
    "./react": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./maplibre": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    },
    "./core/drawing": {
      "types": "./dist/tools/draw/drawing.d.ts",
      "import": "./dist/tools/draw/drawing.js",
      "default": "./dist/tools/draw/drawing.js"
    },
    "./core/data-files": {
      "types": "./dist/tools/data-files/data-files.d.ts",
      "import": "./dist/tools/data-files/data-files.js",
      "default": "./dist/tools/data-files/data-files.js"
    },
    "./core/photo-gps": {
      "types": "./dist/contracts/photo-gps.d.ts",
      "import": "./dist/contracts/photo-gps.js",
      "default": "./dist/contracts/photo-gps.js"
    },
    "./tools/photo": {
      "types": "./dist/tools/photo/index.d.ts",
      "import": "./dist/tools/photo/index.js",
      "default": "./dist/tools/photo/index.js"
    },
    "./tools/draw": {
      "types": "./dist/tools/draw/index.d.ts",
      "import": "./dist/tools/draw/index.js",
      "default": "./dist/tools/draw/index.js"
    },
    "./tools/data-files": {
      "types": "./dist/tools/data-files/index.d.ts",
      "import": "./dist/tools/data-files/index.js",
      "default": "./dist/tools/data-files/index.js"
    },
    "./tools/navigation": {
      "types": "./dist/tools/navigation/index.d.ts",
      "import": "./dist/tools/navigation/index.js",
      "default": "./dist/tools/navigation/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/styles.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/tools/*.test.ts",
    "prepare": "npm run build",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.7.1 || ^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "react-map-gl": {
      "optional": true
    }
  },
  "dependencies": {
    "@turf/bbox": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "lucide-react": "^0.542.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@xmldom/xmldom": "^0.9.12",
    "fake-indexeddb": "^6.2.4",
    "happy-dom": "21.0.4",
    "maplibre-gl": "^6.15.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-map-gl": "^8.0.4",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
